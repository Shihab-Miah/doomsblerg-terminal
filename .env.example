"""
DoomsBlerg .env.example
=======================
Copy this file to .env and fill in your free API keys.
Every single key below is FREE — no credit card required.
"""

# REAL-TIME US STOCKS, CRYPTO, OPTIONS + PAPER TRADING
# Free signup: https://alpaca.markets
ALPACA_API_KEY=your_free_key_here
ALPACA_SECRET_KEY=your_free_secret_here
ALPACA_PAPER=true

# GLOBAL STOCK QUOTES, PROFILES, NEWS, EARNINGS & RECOMMENDATIONS
# Free signup: https://finnhub.io
FINNHUB_API_KEY=your_free_key_here

# MACROECONOMIC DATA (Inflation, GDP, Fed Rates, Employment, Credit Spreads)
# Free signup: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_free_key_here

# LIVE SHIP TRACKING (AIS Maritime Intelligence)
# Free signup (GitHub OAuth): https://aisstream.io/account
AISSTREAM_API_KEY=your_free_key_here

# NASA WILDFIRE SATELLITE DATA
# Free signup: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_API_KEY=your_free_key_here

# US ENERGY INVENTORIES (Crude Oil, Natural Gas, Refineries)
# Free signup: https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_free_key_here

# US AGRICULTURAL CROP PROGRESS & YIELD REPORTS
# Free signup: https://quickstats.nass.usda.gov/api
USDA_NASS_API_KEY=your_free_key_here

# HISTORICAL CLIMATE & DROUGHT DATA (NOAA CDO)
# Free signup: https://www.ncdc.noaa.gov/cdo-web/token
NOAA_CDO_TOKEN=your_free_token_here

# MULTI-ASSET & PRICE CROSS-VERIFICATION FEEDS
# Free signup: https://twelvedata.com/register
TWELVEDATA_API_KEY=your_free_key_here
# Free signup: https://site.financialmodelingprep.com/register
FMP_API_KEY=your_free_key_here
# Free signup: https://www.tiingo.com
TIINGO_API_KEY=your_free_key_here
# Free signup: https://massive.com/dashboard/signup
MASSIVE_API_KEY=your_free_key_here
# Free signup: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_free_key_here

# AI AGENTS (Free Multi-Model Council + Failover)
# Free signup: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_free_key_here
# Free signup: https://console.groq.com/login
GROQ_API_KEY=your_free_key_here

# NO KEY NEEDED (Work automatically out of the box):
# - SEC EDGAR (10-K, 10-Q, 8-K, Form 4 insiders, 13F whale holdings)
# - USGS Earthquakes (real-time seismic hazard feed)
# - Open-Meteo (global 16-day weather forecasts & archive)
# - NASA POWER (agricultural solar/soil/precipitation satellite data)
# - National Weather Service (api.weather.gov US severe alerts)
# - OpenSky Network & adsb.lol (live ADS-B flight tracking)
# - CelesTrak (satellite orbital TLE data)
# - US Treasury (daily yield curves)
# - FINRA (short interest reports)
# - Hyperliquid & Binance Futures public APIs (crypto perps funding & OI)
# - Google News RSS & GDELT Project (real-time headlines & global events)
# - yfinance (historical OHLCV & options chains)
