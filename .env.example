"""
DoomsBlerg .env.example
=======================
Copy this file to .env and fill in your free API keys.
Every single key below is FREE — no credit card required.

Signup links included for each one.
"""

# ─────────────────────────────────────────────────────────────
# REAL-TIME STOCK PRICES
# Free signup: https://alpaca.markets
# No deposit needed — just create a paper trading account
# ─────────────────────────────────────────────────────────────
ALPACA_API_KEY=your_free_key_here
ALPACA_SECRET_KEY=your_free_secret_here
ALPACA_PAPER=true

# ─────────────────────────────────────────────────────────────
# REAL-TIME GLOBAL MARKET DATA + NEWS + EARNINGS ESTIMATES
# Free signup: https://finnhub.io
# Takes 60 seconds, no credit card
# ─────────────────────────────────────────────────────────────
FINNHUB_API_KEY=your_free_key_here

# ─────────────────────────────────────────────────────────────
# MACROECONOMIC DATA (Inflation, GDP, Fed Rates, Employment)
# Free signup: https://fred.stlouisfed.org/docs/api/api_key.html
# Same data Bloomberg uses for ECO, ECST, BTMM, YCRV functions
# ─────────────────────────────────────────────────────────────
FRED_API_KEY=your_free_key_here

# ─────────────────────────────────────────────────────────────
# LIVE SHIP TRACKING (AIS Maritime Intelligence)
# Free signup: https://aisstream.io
# Takes 30 seconds
# ─────────────────────────────────────────────────────────────
AISSTREAM_API_KEY=your_free_key_here

# ─────────────────────────────────────────────────────────────
# NASA WILDFIRE SATELLITE DATA
# Free signup: https://firms.modaps.eosdis.nasa.gov/api/
# Takes 2 minutes (NASA EarthData account)
# ─────────────────────────────────────────────────────────────
NASA_FIRMS_API_KEY=your_free_key_here

# ─────────────────────────────────────────────────────────────
# AI AGENTS (Gemini Free Tier)
# Free signup: https://aistudio.google.com
# 1,000,000 tokens/day free — enough for heavy daily use
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_free_key_here

# ─────────────────────────────────────────────────────────────
# OPTIONS CHAIN (Tradier Developer Sandbox)
# Free signup: https://developer.tradier.com
# No credit card — developer account is permanently free
# ─────────────────────────────────────────────────────────────
TRADIER_API_KEY=your_free_key_here

# ─────────────────────────────────────────────────────────────
# NO KEY NEEDED (These work automatically, zero signup):
# - SEC EDGAR (financial statements, filings, insiders, 13F)
# - USGS Earthquakes (real-time seismic data)
# - OpenSky Network (live flight tracking / ADS-B)
# - adsb.lol (live flight tracking backup)
# - CelesTrak (satellite orbital data)
# - US Treasury (yield curve data)
# - FINRA (short interest data)
# - Google News RSS (financial headlines)
# - yfinance (historical stock prices, options snapshots)
# - GDELT Project (global news event intelligence)
# - USPTO Open Data (patent filings)
# - House/Senate STOCK Act disclosures (congressional trades)
# ─────────────────────────────────────────────────────────────
